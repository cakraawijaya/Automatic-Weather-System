    {
        "id": "976573aa00157f44",
        "type": "function",
        "z": "64acc005fd122c55",
        "g": "e7e035e1ccc68925",
        "name": "simpan ke database",
        "func": "if (!msg.payload) {\n    return null;\n}\n\nvar timestamp = Math.round(Date.now() / 1000);\n\nmsg.topic =\n    `INSERT INTO monitoring (temperature, humidity, distance, timestamp) VALUES (\n    ${msg.payload.temperature},\n    ${msg.payload.humidity},\n    ${msg.payload.distance},\n    ${timestamp}\n)`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 40,
        "wires": [
            [
                "d24f88e60b6d5a86"
            ]
        ]
    },
    {
        "id": "5ccc29296d8ab0d4",
        "type": "function",
        "z": "64acc005fd122c55",
        "g": "6c690546b7ce4f8d",
        "name": "membuat pesan telegram",
        "func": "var temperature = msg.payload[0][0].temperature;\nvar humidity = msg.payload[0][0].humidity;\nvar distanceCm = msg.payload[0][0].distance;\nvar threshold = msg.payload[1][0].threshold;\n\nvar timestamp = new Date(msg.payload[0][0].timestamp*1000);\n\n\nmsg.payload = {\n\"content\" : \"AUTOMATIC WEATHER SYSTEM\\n\\nSuhu : \"+temperature+\" °C\\nHumidity : \"+humidity+\" %\\nJarak air ke permukaan : \"+distanceCm+\" Cm\\nAmbang batas jarak Air: \"+threshold+\" Cm\\nWaktu Setempat: \"+timestamp+\"\",\n\"chatId\" : 1000064401,\n\"type\" : \"message\"\n};\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1150,
        "y": 760,
        "wires": [
            [
                "833531f935eac636"
            ]
        ]
    },
