        "g": "1399e701a086c44b",
        "name": "Status",
        "func": "// Ambil threshold\nlet threshold = Number(msg.payload[0].threshold);\n\n// Ambil distance yang disimpan\nlet distance = flow.get(\"distance\");\n\n// Jika belum ada data\nif (distance == null) {\n    msg.payload = \"--\";\n    return msg;\n}\n\n// Logika\nif (distance <= threshold) {\n    msg.payload = \"🔴BAHAYA\";\n} else {\n    msg.payload = \"🟢AMAN\";\n}\n\nreturn msg;",
